#!/bin/sh
# Files only: the package never restarts PostgreSQL, edits a live cluster or runs CREATE EXTENSION.
set -e
case "$1" in
    configure)
        if [ -z "$2" ]; then
            echo "adaptive_autovacuum files installed for PostgreSQL @PGMAJOR@."
            echo "Configure and activate with: sudo adaptive-autovacuum-setup install --database <name>"
        fi
        ;;
esac
#DEBHELPER#
exit 0
